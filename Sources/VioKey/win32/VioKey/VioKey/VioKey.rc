// VioKey resource script — SaaS 2026 Sidebar Edition.
//
#pragma code_page(65001)

#include "resource.h"
#include "windows.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
// Icon (lowest ID first so the application icon stays consistent)

IDI_APP_ICON            ICON                    "icon.ico"
IDI_ICON_STATUS_VIET    ICON                    "StatusViet.ico"
IDI_ICON_STATUS_ENG     ICON                    "StatusEng.ico"
IDI_ICON_STATUS_VIET_10 ICON                    "StatusViet10.ico"
IDI_ICON_STATUS_ENG_10  ICON                    "StatusEng10.ico"

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_ABOUTBOX DIALOGEX 0, 0, 268, 146
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Giới thiệu VioKey"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APP_ICON,IDC_STATIC,18,16,20,20
    LTEXT           "VioKey",IDC_STATIC_APP_TITLE,48,12,190,16,SS_NOPREFIX
    LTEXT           "Bộ gõ Tiếng Việt thế hệ mới cho Windows",IDC_STATIC_APP_SUB_TITLE,48,30,196,10
    LTEXT           "Phiên bản",IDC_STATIC_APP_VERSION,48,43,196,10
    LTEXT           "Kiến trúc gọn nhẹ, tốc độ phản hồi O(1), chỉ tập trung vào Telex & VNI chuẩn Unicode. Lấy cảm hứng từ dự án mã nguồn mở OpenKey (GPLv3).",IDC_STATIC_APP_CREDIT,20,68,228,28
    PUSHBUTTON      "Trang dự án...",IDC_BUTTON_GO_SOURCE_CODE,18,112,82,18
    DEFPUSHBUTTON   "Đóng",IDBUTTON_OK,182,112,68,18
END

IDD_DIALOG_MAIN DIALOGEX 0, 0, 444, 276
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "VioKey — Bảng điều khiển"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // Left Sidebar: Brand + Navigation + Mode Switcher + Theme
    ICON            IDI_APP_ICON,IDC_STATIC,12,14,20,20
    LTEXT           "VioKey",IDC_STATIC_TITLE,38,11,76,16,SS_NOPREFIX
    LTEXT           "Unicode • O(1)",IDC_STATIC_SUBTITLE,38,26,76,10

    PUSHBUTTON      "Bộ gõ & Chính tả",IDC_TAB_BUTTON_GENERAL,10,50,104,20
    PUSHBUTTON      "Bảng gõ tắt",IDC_TAB_BUTTON_MACRO,10,74,104,20
    PUSHBUTTON      "Hệ thống & Phím",IDC_TAB_BUTTON_SYSTEM,10,98,104,20

    LTEXT           "CHẾ ĐỘ GÕ",IDC_STATIC_SECTION_LEFT,14,196,96,9
    CONTROL         "Tiếng Việt",IDC_RADIO_METHOD_VIETNAMESE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,10,208,51,16
    CONTROL         "Tiếng Anh",IDC_RADIO_METHOD_ENGLISH,"Button",BS_AUTORADIOBUTTON,63,208,51,16

    PUSHBUTTON      "Giao diện",IDC_BUTTON_THEME_TOGGLE,10,232,104,16
    PUSHBUTTON      "Đóng",IDBUTTON_OK,10,252,104,16

    // Right Top Quick Bar: Input Method Pills + Switch Key Chips
    LTEXT           "Kiểu gõ",IDC_STATIC,142,20,28,10
    CONTROL         "Telex",IDC_RADIO_INPUT_TELEX,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,174,16,36,16
    CONTROL         "VNI",IDC_RADIO_INPUT_VNI,"Button",BS_AUTORADIOBUTTON,211,16,34,16

    LTEXT           "Chuyển",IDC_STATIC,256,20,28,10
    CONTROL         "Ctrl",IDC_CHECK_SWITCH_KEY_CTRL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,286,17,24,14
    CONTROL         "Alt",IDC_CHECK_SWITCH_KEY_ALT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,312,17,22,14
    CONTROL         "Win",IDC_CHECK_SWITCH_KEY_WIN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,336,17,25,14
    CONTROL         "Shift",IDC_CHECK_SWITCH_KEY_SHIFT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,363,17,27,14
    EDITTEXT        IDC_SWITCH_KEY_KEY,393,17,28,14,ES_CENTER | ES_AUTOHSCROLL
END

IDD_DIALOG_TAB_GENERAL DIALOGEX 0, 0, 300, 214
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Bộ gõ & Chính tả",IDC_STATIC_PAGE_HEADER,12,8,200,14,SS_NOPREFIX
    LTEXT           "Tùy chỉnh quy tắc bỏ dấu, kiểm tra chính tả và gõ nhanh phụ âm.",IDC_STATIC_PAGE_DESC,12,23,276,10,SS_NOPREFIX

    LTEXT           "CHÍNH TẢ & BỎ DẤU",IDC_STATIC_SECTION_LEFT,12,42,134,10,SS_NOPREFIX
    CONTROL         "Đặt dấu kiểu mới (oà, uý)",IDC_CHECK_MODERN_ORTHORGRAPHY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,56,136,13
    CONTROL         "Kiểm tra chính tả tiếng Việt",IDC_CHECK_SPELLING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,75,136,13
    CONTROL         "Tự khôi phục phím với từ sai",IDC_CHECK_RESTORE_IF_WRONG_SPELLING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,94,136,13
    CONTROL         "Cho phép z, w, j, f làm phụ âm",IDC_CHECK_ALLOW_ZJWF,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,113,136,13
    CONTROL         "Viết hoa chữ cái đầu câu",IDC_CHECK_CAPS_FIRST_CHAR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,132,136,13
    CONTROL         "Nhớ chế độ gõ theo ứng dụng",IDC_CHECK_SMART_SWITCH_KEY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,151,136,13
    CONTROL         "Sửa lỗi gợi ý (Trình duyệt, Excel)",IDC_CHECK_FIX_RECOMMEND_BROWSER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,170,136,13

    LTEXT           "GÕ NHANH & PHÍM TẠM TẮT",IDC_STATIC_SECTION_RIGHT,158,42,136,10,SS_NOPREFIX
    CONTROL         "Gõ nhanh Telex (cc=ch, gg=gi...)",IDC_CHECK_QUICK_TELEX,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,158,56,136,13
    CONTROL         "Phụ âm đầu (f→ph, j→gi, w→qu)",IDC_CHECK_QUICK_START_CONSONANT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,158,75,136,13
    CONTROL         "Phụ âm cuối (g→ng, h→nh, k→ch)",IDC_CHECK_QUICK_END_CONSONANT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,158,94,136,13
    CONTROL         "Tạm tắt chính tả bằng phím Ctrl",IDC_CHECK_TEMP_OFF_SPELLING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,158,113,136,13
    CONTROL         "Tạm tắt VioKey bằng phím Alt",IDC_CHECK_TEMP_OFF_VIOKEY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,158,132,136,13
    CONTROL         "Kêu tiếng bíp khi đổi chế độ",IDC_CHECK_SWITCH_KEY_BEEP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,158,151,136,13
END

IDD_DIALOG_TAB_MACRO DIALOGEX 0, 0, 300, 214
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Bảng gõ tắt (Macro)",IDC_STATIC_PAGE_HEADER,12,8,200,14,SS_NOPREFIX
    LTEXT           "Tự động mở rộng từ viết tắt sang cụm từ đầy đủ khi gõ phím cách.",IDC_STATIC_PAGE_DESC,12,23,276,10,SS_NOPREFIX

    CONTROL         "Bật gõ tắt",IDC_CHECK_USE_MACRO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,40,70,13
    CONTROL         "Gõ tắt cả ở Tiếng Anh",IDC_CHECK_USE_MACRO_IN_ENGLISH,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,88,40,100,13
    CONTROL         "Tự động hoa/thường",IDC_CHECK_AUTO_CAPS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,194,40,98,13

    LTEXT           "TỪ VIẾT TẮT",IDC_STATIC_SECTION_LEFT,12,58,68,9,SS_NOPREFIX
    LTEXT           "NỘI DUNG THAY THẾ",IDC_STATIC_SECTION_RIGHT,84,58,136,9,SS_NOPREFIX
    EDITTEXT        IDC_EDIT_MACRO_NAME,12,69,68,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_MACRO_CONTENT,84,69,136,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "+ Thêm",IDC_BUTTON_ADD,224,69,34,14
    PUSHBUTTON      "Xóa",IDC_BUTTON_DELETE,260,69,28,14

    CONTROL         "",IDC_LIST_MACRO_DATA,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_ALIGNLEFT | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP,12,88,276,98

    PUSHBUTTON      "Nạp từ file...",IDC_BUTTON_IMPORT_MACRO,12,191,66,16
    PUSHBUTTON      "Xuất ra file...",IDC_BUTTON_EXPORT_MACRO,82,191,66,16
END

IDD_DIALOG_TAB_SYSTEM DIALOGEX 0, 0, 300, 214
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Hệ thống & Tương thích",IDC_STATIC_PAGE_HEADER,12,8,200,14,SS_NOPREFIX
    LTEXT           "Quản lý khởi động cùng Windows, quyền trò chơi và thông tin ứng dụng.",IDC_STATIC_PAGE_DESC,12,23,276,10,SS_NOPREFIX

    LTEXT           "KHỞI ĐỘNG & QUYỀN HẠN",IDC_STATIC_SECTION_LEFT,12,42,136,10,SS_NOPREFIX
    CONTROL         "Khởi động cùng Windows",IDC_CHECK_RUN_WITH_WINDOWS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,56,136,13
    CONTROL         "Mở bảng này khi khởi động",IDC_CHECK_SHOW_ON_STARTUP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,75,136,13
    CONTROL         "Chạy quyền Admin (gõ trong Game)",IDC_CHECK_RUN_AS_ADMIN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,94,136,13

    LTEXT           "KHAY HỆ THỐNG & GỬI PHÍM",IDC_STATIC_SECTION_RIGHT,158,42,136,10,SS_NOPREFIX
    CONTROL         "Icon khay đơn sắc (trắng/đen)",IDC_CHECK_MODERN_ICON,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,158,56,136,13
    CONTROL         "Dùng Clipboard để gửi phím",IDC_CHECK_USE_CLIPBOARD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,158,75,136,13

    LTEXT           "THÔNG TIN PHIÊN BẢN",IDC_STATIC_APP_TITLE,12,126,200,10
    LTEXT           "VioKey 1.0.0",IDC_STATIC_APP_VERSION,12,140,276,10
    LTEXT           "Bộ gõ Tiếng Việt siêu nhẹ chuẩn Unicode (GPLv3). Một file thực thi duy nhất.",IDC_STATIC_APP_CREDIT,12,153,276,12

    PUSHBUTTON      "Khôi phục mặc định",ID_BTN_DEFAULT,12,184,84,18
    PUSHBUTTON      "Trang dự án...",IDC_BUTTON_GO_SOURCE_CODE,102,184,72,18
    PUSHBUTTON      "Thoát VioKey",IDBUTTON_EXIT,216,184,72,18
END

/////////////////////////////////////////////////////////////////////////////
// Version

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "The VioKey Project"
            VALUE "FileDescription", "VioKey - Bộ gõ Tiếng Việt cho Windows"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "VioKey.exe"
            VALUE "LegalCopyright", "VioKey (GPLv3)"
            VALUE "OriginalFilename", "VioKey.exe"
            VALUE "ProductName", "VioKey"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
// String Table

STRINGTABLE
BEGIN
    IDS_APP_TITLE           "VioKey"
    IDS_TRAY_TITLE          "VioKey: Tiếng Anh — Bấm để bật Tiếng Việt"
    IDS_TRAY_TITLE_2        "VioKey: Tiếng Việt — Bấm để chuyển Tiếng Anh"
    IDS_MAIN_DIALOG_TITLE   "VioKey %s"
    IDS_STRING_MODERN_ORTHORGRAPHY "Bỏ dấu kiểu mới: ""hoà, thuý"" thay vì kiểu cũ: ""hòa, thúy"""
    IDS_STRING_FIX_BROWSER  "Sửa lỗi đúp từ trên thanh địa chỉ trình duyệt, Microsoft Excel,..."
    IDS_STRING_SPELLING_CHECK "Kiểm tra chính tả tương đối, hạn chế gõ sai từ, cải thiện việc gõ Tiếng Anh khi bật chế độ gõ Tiếng Việt"
    IDS_STRING_RESTORE_IF_WRONG_SPELLING "Từ nào sai Tiếng Việt thì tự động phục hồi lại những phím đã gõ"
    IDS_STRING_USE_CLIPBOARD "Nếu có ứng dụng nào không thể gõ Tiếng Việt, hãy bật tính năng này. Bình thường không nên dùng."
    IDS_STRING_ALLOW_ZWFJ   "Vẫn cho phép dùng các chữ z w f j làm phụ âm khi bật kiểm tra chính tả"
    IDS_STRING_TEMP_OFF_SPELLING "Tạm tắt kiểm tra chính tả cho từ đang gõ (Đắk Lắk, Krông,...) bằng phím Ctrl. Chính tả được bật lại ở từ tiếp theo"
    IDS_STRING_MODERN_ICON  "Dùng biểu tượng đơn sắc đồng bộ với thanh taskbar của Windows 10/11"
    IDS_STRING_CAPS_FIRST_CHAR "Tự động viết hoa sau dấu chấm câu và sau khi xuống dòng"
    IDS_STRING_SMART_SWITCH_KEY "VioKey ghi nhớ chế độ gõ Việt/Anh cho từng ứng dụng và tự chuyển khi bạn đổi ứng dụng"
    IDS_STRING_RUN_ON_STARTUP "Tự chạy VioKey khi khởi động Windows"
    IDS_STRING_SHOW_ON_STARTUP "Hiện bảng điều khiển mỗi lần chạy VioKey"
    IDS_STRING_RUN_AS_ADMIN "Chạy VioKey với quyền Admin để gõ được Tiếng Việt trong game. Bạn sẽ được yêu cầu khởi động lại chương trình"
    IDS_STRING_TEMP_OFF_VIOKEY "Bấm phím Alt để VioKey tạm ngừng hoạt động cho tới khi bạn gõ một từ mới"
    IDS_STRING_CTRL         "Kết hợp phím Ctrl trong tổ hợp chuyển nhanh"
    IDS_STRING_ALT          "Kết hợp phím Alt trong tổ hợp chuyển nhanh"
    IDS_STRING_SHIFT        "Kết hợp phím Shift trong tổ hợp chuyển nhanh"
    IDS_STRING_WIN          "Kết hợp phím Windows trong tổ hợp chuyển nhanh"
    IDS_STRING_SWITCH_KEY   "Nhấn phím bất kỳ để đặt làm phím chuyển (Delete/Backspace để xóa)"
    IDS_STRING_BEEP         "Kêu tiếng bíp mỗi khi bấm tổ hợp chuyển chế độ gõ"
    IDS_STRING_VIET         "Bật chế độ gõ Tiếng Việt"
    IDS_STRING_ENG          "Chuyển sang chế độ Tiếng Anh"
    IDS_STRING_INPUT        "Chọn kiểu gõ Telex hoặc VNI"
    IDS_STRING_MACRO        "Bật tính năng gõ tắt"
    IDS_STRING_QUICK_TELEX  "Thay thế cc=ch, gg=gi, kk=kh, nn=ng, qq=qu, pp=ph, tt=th"
    IDS_STRING_MACRO_IN_ENG "Vẫn gõ tắt được khi bạn đang ở chế độ Tiếng Anh"
    IDS_STRING_MACRO_AUTO_CAP "Tự động đổi chữ hoa. VD: định nghĩa ""ko = không"", gõ ""KO"" thành ""KHÔNG"", gõ ""Ko"" thành ""Không"""
    IDS_STRING_START_CONSONANT "Thay nhanh phụ âm đầu f, j, w bằng ph, gi, qu. Ví dụ: fải→phải, jảng→giảng, wên→quên"
    IDS_STRING_END_CONSONANT "Thay nhanh phụ âm cuối g, h, k bằng ng, nh, ch. Ví dụ: trươg→trương, nhah→nhanh, bák→bách"
    IDS_STRING_THEME_TOGGLE "Chuyển đổi giao diện Sáng (Light) / Tối (Dark)"
END
