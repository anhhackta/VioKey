// VioKey resource script.
//
#pragma code_page(65001)

#include "resource.h"
#include "windows.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
// Icon (lowest ID first so the application icon stays consistent)

IDI_APP_ICON            ICON                    "icon.ico"
IDI_ICON_STATUS_VIET    ICON                    "StatusViet.ico"
IDI_ICON_STATUS_ENG     ICON                    "StatusEng.ico"
IDI_ICON_STATUS_VIET_10 ICON                    "StatusViet10.ico"
IDI_ICON_STATUS_ENG_10  ICON                    "StatusEng10.ico"

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_ABOUTBOX DIALOGEX 0, 0, 268, 146
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Giới thiệu VioKey"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APP_ICON,IDC_STATIC,18,16,20,20
    LTEXT           "VioKey",IDC_STATIC_APP_TITLE,48,12,190,16,SS_NOPREFIX
    LTEXT           "Bộ gõ Tiếng Việt thế hệ mới cho Windows",IDC_STATIC_APP_SUB_TITLE,48,30,196,10
    LTEXT           "Phiên bản",IDC_STATIC_APP_VERSION,48,43,196,10
    LTEXT           "Kiến trúc gọn nhẹ, tốc độ phản hồi O(1), chỉ tập trung vào Telex & VNI chuẩn Unicode. Lấy cảm hứng từ dự án mã nguồn mở OpenKey (GPLv3).",IDC_STATIC_APP_CREDIT,20,68,228,28
    PUSHBUTTON      "Trang dự án...",IDC_BUTTON_GO_SOURCE_CODE,18,112,82,18
    DEFPUSHBUTTON   "Đóng",IDBUTTON_OK,182,112,68,18
END

IDD_DIALOG_MAIN DIALOGEX 0, 0, 356, 290
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "VioKey — Bộ gõ Tiếng Việt"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APP_ICON,IDC_STATIC,16,13,20,20
    LTEXT           "VioKey",IDC_STATIC_TITLE,42,10,90,16,SS_NOPREFIX
    LTEXT           "Unicode • Telex & VNI • 2026 Edition",IDC_STATIC_SUBTITLE,42,26,150,10

    PUSHBUTTON      "Giao diện",IDC_BUTTON_THEME_TOGGLE,194,15,44,16
    CONTROL         "Tiếng Việt",IDC_RADIO_METHOD_VIETNAMESE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,244,15,48,16
    CONTROL         "Tiếng Anh",IDC_RADIO_METHOD_ENGLISH,"Button",BS_AUTORADIOBUTTON,293,15,48,16

    LTEXT           "Kiểu gõ",IDC_STATIC,24,54,32,10
    COMBOBOX        IDC_COMBO_INPUT_TYPE,60,51,64,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Phím chuyển",IDC_STATIC,138,54,48,10
    CONTROL         "Ctrl",IDC_CHECK_SWITCH_KEY_CTRL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,190,51,26,14
    CONTROL         "Alt",IDC_CHECK_SWITCH_KEY_ALT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,218,51,24,14
    CONTROL         "Win",IDC_CHECK_SWITCH_KEY_WIN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,244,51,26,14
    CONTROL         "Shift",IDC_CHECK_SWITCH_KEY_SHIFT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,272,51,28,14
    EDITTEXT        IDC_SWITCH_KEY_KEY,303,51,28,14,ES_CENTER | ES_AUTOHSCROLL

    LTEXT           "Mẹo: Nhấn đúp Ctrl tạm tắt chính tả • Nhấn đúp Alt tạm tắt bộ gõ",IDC_STATIC_APP_CREDIT,24,73,246,10
    CONTROL         "Bíp",IDC_CHECK_SWITCH_KEY_BEEP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,282,71,48,13

    PUSHBUTTON      "Bộ gõ & Chính tả",IDC_TAB_BUTTON_GENERAL,14,97,88,18
    PUSHBUTTON      "Gõ tắt & Tăng tốc",IDC_TAB_BUTTON_MACRO,106,97,88,18
    PUSHBUTTON      "Hệ thống",IDC_TAB_BUTTON_SYSTEM,198,97,74,18

    PUSHBUTTON      "Khôi phục gốc",ID_BTN_DEFAULT,14,262,74,18
    PUSHBUTTON      "Thoát VioKey",IDBUTTON_EXIT,94,262,74,18
    DEFPUSHBUTTON   "Đóng",IDBUTTON_OK,272,262,70,18
END

IDD_DIALOG_MACRO DIALOGEX 0, 0, 392, 260
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Bảng gõ tắt — VioKey"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Từ viết tắt",IDC_STATIC,14,10,60,10
    LTEXT           "Nội dung thay thế",IDC_STATIC,98,10,90,10
    EDITTEXT        IDC_EDIT_MACRO_NAME,14,22,78,15,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_MACRO_CONTENT,98,22,196,15,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "+ Thêm",IDC_BUTTON_ADD,300,22,38,15
    PUSHBUTTON      "Xóa",IDC_BUTTON_DELETE,342,22,36,15
    CONTROL         "",IDC_LIST_MACRO_DATA,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_ALIGNLEFT | WS_TABSTOP,14,46,364,176
    PUSHBUTTON      "Nạp từ file...",IDC_BUTTON_IMPORT_MACRO,14,232,70,18
    PUSHBUTTON      "Xuất ra file...",IDC_BUTTON_EXPORT_MACRO,90,232,70,18
    CONTROL         "Tự viết hoa theo từ gõ tắt",IDC_CHECK_AUTO_CAPS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,174,235,132,12
    PUSHBUTTON      "Đóng",IDBUTTON_OK,314,232,64,18
END

IDD_DIALOG_TAB_GENERAL DIALOGEX 0, 0, 324, 130
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "CHÍNH TẢ & BỎ DẤU",IDC_STATIC_SECTION_LEFT,10,8,142,10
    CONTROL         "Đặt dấu kiểu mới (oà, uý)",IDC_CHECK_MODERN_ORTHORGRAPHY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,24,146,13
    CONTROL         "Kiểm tra chính tả tiếng Việt",IDC_CHECK_SPELLING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,44,146,13
    CONTROL         "Tự khôi phục phím với từ sai",IDC_CHECK_RESTORE_IF_WRONG_SPELLING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,64,146,13
    CONTROL         "Cho phép z, w, j, f làm phụ âm",IDC_CHECK_ALLOW_ZJWF,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,84,146,13
    CONTROL         "Viết hoa chữ cái đầu câu",IDC_CHECK_CAPS_FIRST_CHAR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,104,146,13

    LTEXT           "THÔNG MINH & TƯƠNG THÍCH",IDC_STATIC_SECTION_RIGHT,168,8,148,10
    CONTROL         "Nhớ chế độ gõ theo ứng dụng",IDC_CHECK_SMART_SWITCH_KEY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,168,24,148,13
    CONTROL         "Tạm tắt chính tả bằng phím Ctrl",IDC_CHECK_TEMP_OFF_SPELLING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,168,44,148,13
    CONTROL         "Tạm tắt VioKey bằng phím Alt",IDC_CHECK_TEMP_OFF_VIOKEY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,168,64,148,13
    CONTROL         "Sửa lỗi gợi ý (Trình duyệt, Excel)",IDC_CHECK_FIX_RECOMMEND_BROWSER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,168,84,148,13
END

IDD_DIALOG_TAB_MACRO DIALOGEX 0, 0, 324, 130
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "BẢNG GÕ TẮT (MACRO)",IDC_STATIC_SECTION_LEFT,10,8,142,10
    CONTROL         "Bật tính năng gõ tắt",IDC_CHECK_USE_MACRO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,24,146,13
    CONTROL         "Gõ tắt cả khi ở chế độ Tiếng Anh",IDC_CHECK_USE_MACRO_IN_ENGLISH,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,44,146,13
    CONTROL         "Tự động viết hoa theo từ tắt",IDC_CHECK_AUTO_CAPS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,64,146,13
    PUSHBUTTON      "Thiết lập bảng gõ tắt...",IDC_BUTTON_MACRO_TABLE,10,90,120,18

    LTEXT           "GÕ NHANH PHỤ ÂM",IDC_STATIC_SECTION_RIGHT,168,8,148,10
    CONTROL         "Gõ nhanh Telex (cc=ch, gg=gi...)",IDC_CHECK_QUICK_TELEX,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,168,24,148,13
    CONTROL         "Phụ âm đầu (f→ph, j→gi, w→qu)",IDC_CHECK_QUICK_START_CONSONANT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,168,44,148,13
    CONTROL         "Phụ âm cuối (g→ng, h→nh, k→ch)",IDC_CHECK_QUICK_END_CONSONANT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,168,64,148,13
END

IDD_DIALOG_TAB_SYSTEM DIALOGEX 0, 0, 324, 130
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "KHỞI ĐỘNG & QUYỀN HẠN",IDC_STATIC_SECTION_LEFT,10,8,146,10
    CONTROL         "Khởi động cùng Windows",IDC_CHECK_RUN_WITH_WINDOWS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,24,146,13
    CONTROL         "Mở bảng điều khiển khi khởi động",IDC_CHECK_SHOW_ON_STARTUP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,44,146,13
    CONTROL         "Chạy với quyền Admin (gõ trong Game)",IDC_CHECK_RUN_AS_ADMIN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,64,150,13

    LTEXT           "GIAO DIỆN & TƯƠNG THÍCH",IDC_STATIC_SECTION_RIGHT,168,8,148,10
    CONTROL         "Biểu tượng khay đơn sắc (trắng/đen)",IDC_CHECK_MODERN_ICON,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,168,24,150,13
    CONTROL         "Dùng Clipboard để gửi phím",IDC_CHECK_USE_CLIPBOARD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,168,44,148,13
END

/////////////////////////////////////////////////////////////////////////////
// Version

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "The VioKey Project"
            VALUE "FileDescription", "VioKey - Bộ gõ Tiếng Việt cho Windows"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "VioKey.exe"
            VALUE "LegalCopyright", "VioKey (GPLv3)"
            VALUE "OriginalFilename", "VioKey.exe"
            VALUE "ProductName", "VioKey"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

